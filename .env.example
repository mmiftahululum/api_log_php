# ============================================
# TEMPLATE KONFIGURASI
# Salin file ini menjadi .env lalu isi nilainya.
#   cp .env.example .env
# File .env TIDAK boleh di-commit ke GitHub.
# ============================================

# Application
APP_ENV=production
APP_DEBUG=false

# Database MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=private_log_api
DB_USER=root
DB_PASS=

# Google OAuth (https://console.cloud.google.com/apis/credentials)
GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=

# Nama header token API
TOKEN_HEADER=mifpro-token
